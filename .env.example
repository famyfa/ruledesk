# Copy to apps/server/.env and fill in. Never commit the real file.
NODE_ENV=production
RULEDECK_HOST=127.0.0.1
RULEDECK_PORT=3000
RULEDECK_DATA_DIR=./data
RULEDECK_ADMIN_USER=admin
# Generate with: npm run hash-password
RULEDECK_ADMIN_PASSWORD_HASH=
# Set to false only when serving over plain http on localhost
RULEDECK_COOKIE_SECURE=true
# Master switch for sending changes to the firewall. Leave false until you have
# tested RuleDeck against a disposable OPNsense instance.
RULEDECK_ALLOW_WRITES=false

OPNSENSE_NAME=Main firewall
OPNSENSE_URL=https://firewall.example.lan
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=
# Optional: PEM CA bundle if the firewall uses a private CA / self-signed cert
OPNSENSE_CA_FILE=
