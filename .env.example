# Copy to apps/server/.env. RuleDeck stores no credentials: people sign in with
# their own OPNsense accounts. This file holds no secrets.
NODE_ENV=production
RULEDECK_HOST=127.0.0.1
RULEDECK_PORT=3000
# Which sites/firewalls exist (no secrets). See ruledeck.topology.example.json.
RULEDECK_TOPOLOGY_FILE=./ruledeck.topology.json
# Set to false only when serving over plain http on localhost
RULEDECK_COOKIE_SECURE=true
# Master switch for sending changes to firewalls. Leave false until you have
# tested RuleDeck against a disposable OPNsense instance.
RULEDECK_ALLOW_WRITES=false
